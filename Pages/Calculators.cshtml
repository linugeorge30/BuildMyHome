@page
@model CalculatorsModel
@{
    ViewData["Title"] = "Quantity calculators";
}

<div class="page-hero">
    <div class="container-xl">
        <p class="eyebrow">Paint, tiles, flooring</p>
        <h1>Quantity calculators</h1>
        <p class="lead">Estimates are processed by the ASP.NET backend from the measurements you enter. Add 10% waste by default. These figures are for planning, not a contractor’s take-off.</p>
    </div>
</div>

<div class="container-xl section">
    <div class="calc-grid">
        <form class="panel" id="calc-form">
            <h2>Room measurements</h2>
            <div class="field-row">
                <label>Width (m)
                    <input name="width" class="form-control" type="number" min="0.5" step="0.1" value="4" required />
                </label>
                <label>Length (m)
                    <input name="length" class="form-control" type="number" min="0.5" step="0.1" value="5" required />
                </label>
                <label>Height (m)
                    <input name="height" class="form-control" type="number" min="2" step="0.1" value="2.7" required />
                </label>
            </div>
            <div class="field-row">
                <label>Doors
                    <input name="doorCount" class="form-control" type="number" min="0" value="1" />
                </label>
                <label>Windows
                    <input name="windowCount" class="form-control" type="number" min="0" value="1" />
                </label>
                <label>Waste %
                    <input name="wastePercent" class="form-control" type="number" min="0" step="1" value="10" />
                </label>
            </div>
            <div class="field-row">
                <label>Paint coats
                    <input name="coats" class="form-control" type="number" min="1" step="1" value="2" />
                </label>
                <label>Paint coverage (m²/L)
                    <input name="paintCoveragePerLitre" class="form-control" type="number" min="1" step="0.5" value="11" />
                </label>
                <label>Tile size (cm)
                    <div class="field-row tight">
                        <input name="tileWidthCm" class="form-control" type="number" min="10" value="60" />
                        <input name="tileLengthCm" class="form-control" type="number" min="10" value="60" />
                    </div>
                </label>
            </div>
            <label>Flooring pack coverage (m²)
                <input name="flooringCoveragePerPack" class="form-control" type="number" min="0.5" step="0.01" value="2.16" />
            </label>
            <button type="submit" class="btn btn-primary">Calculate</button>
        </form>

        <section class="panel estimate-card">
            <h2>Results</h2>
            <ul class="stat-list" id="calc-results">
                <li>Enter measurements and calculate to see litres, tiles, and packs.</li>
            </ul>
            <p class="muted">Paint subtracts a standard door (1.8 × 0.9 m) and window (1.2 × 1.2 m) for each opening you count.</p>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/calculators.js" asp-append-version="true"></script>
}
